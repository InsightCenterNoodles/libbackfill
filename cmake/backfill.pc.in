prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: @BACKFILL_PKGCONFIG_NAME@
Description: The backfill immersive rendering library
Version: @BACKFILL_API_VERSION@
Libs: -L${libdir} -lbackfill-@BACKFILL_ABI_VERSION@
Cflags: -I${includedir}/backfill-@BACKFILL_ABI_VERSION@
